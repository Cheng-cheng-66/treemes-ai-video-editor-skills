[
  {"start":1.41,"end":4.08,"text":"生产现场有五大数据资产","source":"audio_full_review"},
  {"start":4.08,"end":5.46,"text":"第一个最重要的数据资产","source":"audio_full_review"},
  {"start":5.46,"end":9.21,"text":"就是标准工时，标准工时","source":"professional_term_verified"},
  {"start":9.21,"end":13.20,"text":"会决定你的成本","source":"audio_full_review"},
  {"start":13.20,"end":15.36,"text":"你给员工的计件工资","source":"user_verified_exact_quote"},
  {"start":15.36,"end":18.72,"text":"还有你给客户的报价","source":"user_verified_exact_quote"},
  {"start":18.72,"end":20.37,"text":"是我们工厂","source":"audio_full_review"},
  {"start":20.37,"end":24.51,"text":"大部分的标准工时，要么没有","source":"professional_term_verified"},
  {"start":24.51,"end":27.03,"text":"要么有，也只是一个大概","source":"audio_full_review"},
  {"start":27.03,"end":29.25,"text":"有，大概已经不错了","source":"audio_full_review"},
  {"start":29.25,"end":31.05,"text":"其实很多工厂有了标准工时","source":"professional_term_verified"},
  {"start":31.05,"end":34.59,"text":"他们有持续的维护和进化","source":"audio_full_review"},
  {"start":34.59,"end":37.26,"text":"所以标准工时这么重要的数据","source":"professional_term_verified"},
  {"start":37.26,"end":42.00,"text":"就把很多工厂分水岭就切开了","source":"audio_full_review"},
  {"start":42.00,"end":44.97,"text":"管理水平就被划分的有","source":"audio_full_review"},
  {"start":44.97,"end":47.79,"text":"和没有之间","source":"audio_full_review"},
  {"start":47.79,"end":49.92,"text":"如何来得到一份","source":"low_confidence_phrase_reviewed"},
  {"start":49.92,"end":52.83,"text":"准确的标准工时呢","source":"professional_term_verified"},
  {"start":52.83,"end":56.52,"text":"那如果是你有设备的采集","source":"audio_full_review"},
  {"start":56.52,"end":59.91,"text":"设备的节拍","source":"audio_full_review"},
  {"start":59.91,"end":63.87,"text":"然后把异常数据的时间加上去","source":"audio_full_review"},
  {"start":63.87,"end":65.91,"text":"就是标准工时","source":"professional_term_verified"},
  {"start":65.91,"end":69.36,"text":"如果没有设备节拍的采集","source":"audio_full_review"},
  {"start":77.52,"end":82.38,"text":"MES系统的开工和报工的时间差","source":"professional_term_verified"},
  {"start":82.38,"end":84.36,"text":"生产的良品的总数","source":"audio_full_review"},
  {"start":84.36,"end":89.04,"text":"来统计出标准工时","source":"professional_term_verified"},
  {"start":89.04,"end":93.24,"text":"那标准工时我们还要持续维护","source":"professional_term_verified"},
  {"start":93.24,"end":95.31,"text":"仅仅是维护，其实是不够的","source":"audio_full_review"},
  {"start":95.31,"end":97.74,"text":"如果我们没有激励机制","source":"user_feedback_and_audio_reverified"},
  {"start":97.74,"end":99.42,"text":"比如说没有标工计件","source":"user_feedback_and_audio_reverified"},
  {"start":99.42,"end":100.62,"text":"没有员工的激励机制","source":"user_feedback_and_audio_reverified"},
  {"start":100.62,"end":103.83,"text":"来促使大家关心这个数据","source":"audio_full_review"},
  {"start":103.83,"end":107.13,"text":"或者排产和大家的达成率","source":"audio_full_review"},
  {"start":107.13,"end":108.18,"text":"来让团队整个的","source":"audio_full_review"},
  {"start":108.18,"end":110.40,"text":"关心这个数据","source":"audio_full_review"},
  {"start":110.40,"end":112.68,"text":"那这个标准工时估计也没有","source":"professional_term_verified"},
  {"start":112.68,"end":114.78,"text":"持续进化","source":"audio_full_review"},
  {"start":114.78,"end":117.12,"text":"所以我们这个数据是第一步","source":"audio_full_review"},
  {"start":117.12,"end":119.43,"text":"这个数据和大家的收入相关","source":"audio_full_review"},
  {"start":119.43,"end":121.05,"text":"有利益相关方","source":"audio_full_review"},
  {"start":121.05,"end":123.60,"text":"我们的团队领导层","source":"audio_full_review"},
  {"start":123.60,"end":124.41,"text":"或者工艺工程师","source":"professional_term_verified"},
  {"start":124.41,"end":125.64,"text":"也会持续关注它","source":"audio_full_review"},
  {"start":125.64,"end":128.16,"text":"优化它这个标准","source":"audio_full_review"},
  {"start":128.16,"end":130.14,"text":"才是真正的你的数据资产","source":"audio_full_review"}
